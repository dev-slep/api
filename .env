# Committed defaults for local development. Real environment variables win over this file.
# Never put production secrets here: use Symfony Secrets (config/secrets/) or real env vars.

###> symfony/framework-bundle ###
APP_ENV=dev
# Placeholder: override in .env.local or via real env vars outside local development
APP_SECRET=local-development-secret-change-me
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://slep:slep@postgres:5432/slep?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Doctrine (Postgres) transport; finalised in SETUP-15
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
# Postgres advisory locks (own session on the main database); application tests override it with in-memory
LOCK_DSN="postgresql+advisory://slep:slep@postgres:5432/slep"
###< symfony/lock ###

###> external services (local docker-compose) ###
WIREMOCK_URL=http://wiremock:8080
S3_ENDPOINT=http://minio:9000
S3_KEY=slep
S3_SECRET=slep-secret
S3_REGION=us-east-1
MAILER_DSN=smtp://mailpit:1025
###< external services ###

###> problem details ###
# Finalised in SETUP-18
PROBLEM_TYPE_BASE_URI=https://slep.example/problems/
###< problem details ###
