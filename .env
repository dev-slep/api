# Committed defaults for local development. Real environment variables win over this file.
# Never put production secrets here: use Symfony Secrets (config/secrets/) or real env vars.

###> symfony/framework-bundle ###
APP_ENV=dev
# Placeholder: override in .env.local or via real env vars outside local development
APP_SECRET=local-development-secret-change-me
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://slep:slep@postgres:5432/slep?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Doctrine (Postgres) transport; finalised in SETUP-15
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
# Postgres advisory locks (own session on the main database); application tests override it with in-memory
LOCK_DSN="postgresql+advisory://slep:slep@postgres:5432/slep"
###< symfony/lock ###

###> external services (local docker-compose) ###
WIREMOCK_URL=http://wiremock:8080
S3_ENDPOINT=http://minio:9000
S3_KEY=slep
S3_SECRET=slep-secret
S3_REGION=us-east-1
MAILER_DSN=smtp://mailpit:1025
###< external services ###

###> problem details ###
# Finalised in SETUP-18
PROBLEM_TYPE_BASE_URI=https://slep.example/problems/
###< problem details ###

###> authentication ###
# Access tokens: RS256, keys generated by `make jwt-keys`
JWT_PRIVATE_KEY_PATH=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY_PATH=%kernel.project_dir%/config/jwt/public.pem
JWT_KEY_ID=1
JWT_ISSUER=https://slep.example
JWT_AUDIENCE=slep-api
# Encrypts the TOTP secrets of admins at rest: 32 random bytes, base64 (generate with `openssl rand -base64 32`; never reuse this default)
AUTH_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZHVjdGlvbiE=
AUTH_MAIL_FROM_ADDRESS=no-reply@slep.example
AUTH_MAIL_FROM_NAME=Slep
# Links in emails; {token} is replaced by the token
AUTH_VERIFY_EMAIL_URL=https://slep.example/verify-email?token={token}
AUTH_RESET_PASSWORD_URL=https://slep.example/reset-password?token={token}
# Social sign-in: the app's client ids and the providers' published signing keys
GOOGLE_CLIENT_ID=google-client-id.apps.googleusercontent.com
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
APPLE_CLIENT_ID=com.slep.app
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
###< authentication ###

###> nelmio/cors-bundle ###
# Regular expression of the origins that may call /api/ from a browser (the web app).
# Local default: any localhost port (Expo web, a static export). Staging and production set their own domain.
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###
